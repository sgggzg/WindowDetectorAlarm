<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tv_float_ball"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_float_ball"
        android:text="监\n控"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:gravity="center" />

    <LinearLayout
        android:id="@+id/layout_float_menu"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_float_menu"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:paddingEnd="6dp"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/btn_float_toggle_mask"
            android:layout_width="66dp"
            android:layout_height="32dp"
            android:text="暗屏"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#448AFF"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/btn_float_stop_monitor"
            android:layout_width="76dp"
            android:layout_height="32dp"
            android:text="停止监控"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#FF9800"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:includeFontPadding="false"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/btn_float_pause"
            android:layout_width="76dp"
            android:layout_height="32dp"
            android:text="暂停监控"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#E94560"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:includeFontPadding="false"
            android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
