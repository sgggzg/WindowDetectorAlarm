<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#16213E"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/layoutGroupHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGroupTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="条件组 1"
                android:textColor="@color/accent_red"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGroupSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0 个关键词"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvGroupArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="▶"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.sgggzg.qmzg.ui.view.ExpandableLayout
            android:id="@+id/layoutGroupContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="组内总模糊字数"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnGroupFuzzyMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="−"
                    android:textSize="16sp"
                    android:backgroundTint="#333333" />

                <EditText
                    android:id="@+id/etGroupFuzzy"
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="#0D0D1A"
                    android:gravity="center"
                    android:hint="不限"
                    android:inputType="number"
                    android:padding="0dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#777777"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnGroupFuzzyPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textSize="16sp"
                    android:backgroundTint="@color/accent_blue" />
            </LinearLayout>

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/layoutKeywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:alignItems="flex_start"
                app:flexWrap="wrap"
                app:justifyContent="flex_start" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDeleteGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="删除组"
                    android:textSize="10sp"
                    android:backgroundTint="#333333" />

                <Button
                    android:id="@+id/btnAddKeyword"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:text="+ 添加关键词"
                    android:textSize="10sp"
                    android:backgroundTint="@color/accent_blue" />
            </LinearLayout>
        </com.sgggzg.qmzg.ui.view.ExpandableLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
