<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etKeywordText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="关键词"
        android:inputType="text"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="允许模糊字数"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnFuzzyMinus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−"
            android:textSize="18sp"
            android:backgroundTint="#333333" />

        <TextView
            android:id="@+id/tvFuzzyValue"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnFuzzyPlus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+"
            android:textSize="18sp"
            android:backgroundTint="@color/accent_blue" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="应出现次数"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCountMinus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−"
            android:textSize="18sp"
            android:backgroundTint="#333333" />

        <TextView
            android:id="@+id/tvCountValue"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCountPlus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+"
            android:textSize="18sp"
            android:backgroundTint="@color/accent_blue" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="同一匹配单位内至少出现几次；默认 1。"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tvFuzzyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0 = 不模糊；只对这个关键词生效。"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="10sp" />

    <Button
        android:id="@+id/btnDeleteKeyword"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="删除这个关键词"
        android:textColor="@color/accent_red" />
</LinearLayout>
